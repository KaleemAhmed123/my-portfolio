# Client-side. This value is inlined into the JS bundle, so it must be public-safe.
# The Sanity project id is not a secret; the dataset is public and read-only here.
VITE_APP_SANITY_PROJECT_ID=

# Server-side only, read by api/contact.js. Set these in the Vercel dashboard,
# never in a VITE_-prefixed variable. Scope the token to "write" on the
# `contact` type only; it must never gain read access to other datasets.
SANITY_PROJECT_ID=
SANITY_WRITE_TOKEN=
