{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.kaleemahmed.in"
        }
      ],
      "destination": "https://kaleemahmed.in/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.kaleemahmed.in"
        }
      ],
      "destination": "https://kaleemahmed.in/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/developer",
      "destination": "/index.html"
    },
    {
      "source": "/credentials",
      "destination": "/index.html"
    },
    {
      "source": "/work/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/work/:slug/:tab",
      "destination": "/index.html"
    }
  ]
}
