{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "es2017"
    ],
    "jsx": "react",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "./**/*.js",
    "./**/*.jsx"
  ],
  "exclude": [
    "node_modules"
  ]
}